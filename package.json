{
  "name": "jslabyrinth",
  "version": "1.0.0",
  "description": "JsLabyrinth — 基于 Vercel 的 JavaScript 代码混淆与运行时防护服务：Web 控制台与 JSON API 同域部署，混淆在服务端执行。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./obfuscate": "./src/obfuscate.js",
    "./html": "./src/html.js",
    "./plan": "./src/plan.js",
    "./license-codec": "./src/license-codec.js",
    "./license-web": "./src/license-web.js",
    "./platform": "./src/platform.js",
    "./server": "./server/handler.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "web",
    "server",
    "api",
    "vercel",
    "test",
    "tools",
    "vercel.json",
    "README.md"
  ],
  "scripts": {
    "keygen": "node tools/issue/keygen.js",
    "signingkey": "node tools/issue/signingkey.js",
    "keyrotate": "node tools/issue/keyrotate.js",
    "selfdigest": "node tools/issue/selfdigest.js --write",
    "selfdigest:check": "node tools/issue/selfdigest.js --check",
    "hashtest": "node test/hashtest.js",
    "selftest": "node test/selftest.js",
    "webfp": "node test/webfp.js",
    "bench": "node test/bench.js",
    "bench:minify": "node test/minify-bench.js",
    "semantics": "node test/semantics.js",
    "test": "node test/selftest.js",
    "test:core": "node test/selftest.js core",
    "test:license": "node test/selftest.js license",
    "test:passes": "node test/selftest.js passes",
    "test:vm": "node test/selftest.js vm",
    "build:web": "node tools/build/build-web.js",
    "build:web:cloud": "node tools/build/build-web.js --cloud",
    "verify:enc": "node tools/build/verify-encryption.js",
    "bench:selfobf": "node tools/build/bench-selfobf.js",
    "verify": "node tools/build/verify-deploy.js",
    "deploy": "npx vercel --prod"
  },
  "keywords": [
    "obfuscator",
    "obfuscation",
    "javascript",
    "code-protection",
    "vercel",
    "serverless",
    "webassembly"
  ],
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.17"
  }
}
