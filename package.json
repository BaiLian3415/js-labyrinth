{
  "name": "jslabyrinth",
  "version": "0.2Alpha",
  "description": "JsLabyrinth — 运行在 Vercel 上的 JS 混淆器（免网页 GUI）",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./obfuscate": "./src/obfuscate.js",
    "./html": "./src/html.js",
    "./plan": "./src/plan.js",
    "./license-codec": "./src/license-codec.js",
    "./license-web": "./src/license-web.js",
    "./platform": "./src/platform.js",
    "./server": "./server/handler.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "web",
    "server",
    "api",
    "vercel",
    "tools",
    "vercel.json",
    "README.md"
  ],
  "scripts": {
    "keygen": "node tools/issue/keygen.js",
    "signingkey": "node tools/issue/signingkey.js",
    "keyrotate": "node tools/issue/keyrotate.js",
    "selfdigest": "node tools/issue/selfdigest.js --write",
    "selfdigest:check": "node tools/issue/selfdigest.js --check",
    "hashtest": "node tools/test/hashtest.js",
    "selftest": "node tools/test/selftest.js",
    "webfp": "node tools/test/webfp.js",
    "bench": "node tools/test/bench.js",
    "bench:minify": "node tools/test/minify-bench.js",
    "semantics": "node tools/test/semantics.js",
    "test": "node tools/test/selftest.js",
    "build:web": "node tools/build/build-web.js",
    "build:web:cloud": "node tools/build/build-web.js --cloud",
    "verify:enc": "node tools/build/verify-encryption.js",
    "bench:selfobf": "node tools/build/bench-selfobf.js",
    "verify": "node tools/build/verify-deploy.js",
    "deploy": "npx vercel --prod"
  },
  "keywords": [
    "obfuscator",
    "obfuscation",
    "javascript",
    "protect",
    "vercel",
    "serverless",
    "webassembly"
  ],
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.17"
  }
}
