# 构建产物与本地状态，不随仓库分发

# 网页构建产物（npm run build:web 生成）
dist/

# 目录模式混淆的遗留输出目录（Node 命令行已在 2026-09-21 转向纯云端时删除，
# 这里保留忽略规则以防旧工作区里还有残留）
dist-src/

# 本地许可证文件（v5 起无发卡计数器）
license.lic
license.lic.tmp

# pass 转储（DSH_DUMP_PASSES=1 时生成）
_phase_*.js

# 排查时随手写的本地脚本与截图，一律下划线开头，不进仓库。
# `_preview/` 是本地界面验证目录（响应式探针 probe.mjs / 各视口截图 / 英文残留扫描
# _uiscan.mjs），整体忽略：里面的脚本写死了本机 Chrome 路径、依赖 playwright-core
# 与本地静态服务端口，属于开发机工具，不适合当项目资产分发。
_*.mjs
_*.cjs
_preview/

# 自混淆预算基准的产物目录（tools/build/bench-selfobf.js 每次实跑写在这里）。
# 里面是逐候选配置混淆后的 src/** 副本，只用于量运行期代价，不是发布产物。
_selfobf-bench/

# 密钥与本地环境。
# **卡密密钥**（v5 对称，base64 32 字节）：随源码分发（B64_CODE_KEY），但签发方的
# 私有副本不进仓库；部署方用 npx wrangler secret put JSLB_CODE_KEY 覆盖服务端取值。
# 对称体系里拿到源码就能造卡——真正的强制在服务端（校验 + KV 赎回登记 + 门控）。
# 旧 Ed25519 私钥文件名保留忽略，防止历史文件意外入库。
.jslb-code-key
.jslb-signing-key

# 部署方自己的密钥/策略覆盖（可选）。不同部署用不同密钥时不该入库。
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# 私钥与凭据的通用兜底。上面两个点文件是本项目自己写的路径，这里防的是改了名字
# 或从别处拷进来的（*.pem / *.key / id_rsa 一类）——误收一次就等于把签发权交出去。
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*

# 发卡台账：keygen 的 --ledger / --csv 输出，**每行都是可直接激活的卡密原文**。
# 这是本项目最该藏的本地数据，却最容易在"顺手 git add -A"时进仓库。
issued*.csv
batch*.csv
ledger*.csv
codes.csv
*.codes.csv

# 本地覆盖与联调台账（授权服务地址、机器码绑定导出、本机调试用的覆盖项）。
# 换台机器就失效，写进仓库只会误导别人；`.jslb-code-key` 与 `.jslb-signing-key`
# 两条显式规则也落在这个前缀里，这里一并兜住未来新增的同前缀本地文件。
.jslb-*

# AI 会话记忆。`.workbuddy-ai/memory/` 是旧路径，`.workbuddy/memory/` 是当前路径，
# 两者内容相同：项目约定与踩坑记录，但也可能写到**已签发的卡密原文**，所以默认都不入库。
# （它们同时是工程笔记，日常 `git add -A` 极易误收，因此必须显式忽略而不是靠自觉。）
# 想把它当团队文档共享，就删掉下面两行——删之前先把卡密那几行挪走。
.workbuddy-ai/
.workbuddy/

# 依赖与系统文件
node_modules/
.wrangler/
.DS_Store
Thumbs.db

# 编辑器与终端的本地配置（各人不同，进仓库只会制造无意义冲突）
.vscode/
.idea/
*.swp
*.swo

# 日志与打包残留
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tgz
coverage/
