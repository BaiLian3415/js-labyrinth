# 本地环境变量模板。复制成 .env 后填入真值（.env 在 .gitignore 里）。
#
# ⚠️ 这个文件**只有占位符**，不要填真密钥。完整部署流程见 DEPLOY.md。
#
# 说明：Vercel 上线时环境变量配在**项目设置**里（不是这个文件）；这个文件只管本地
# `npx vercel dev` 与发卡工具。变量名必须与这里一致，否则本地与线上行为会分叉。

# ---- 签发私钥（机密，只在发卡时）----
# 取值：tools/issue/keyrotate.js --write 写入 .jslb-code-key 的那份（base64，32 字节）。
# ⚠️ 泄露 = 泄露发卡权：人能签出任意套餐、任意有效期的卡密，且所有验签方都认。
#    绝不能提交进仓库或贴到 dist/。
JSLB_CODE_KEY=

# ---- 公钥与机器码盐（非机密，可公开）----
# 默认用 src/license-secret.js 里内置的那把，通常不用配。只有"用自己的密钥对"时
# 才需要覆盖成 tools/issue/keyrotate.js 打印的公钥（配在 Vercel 项目设置里）。
JSLB_CODE_KEY=
# 机器码派生盐：只影响未激活时的兜底机器码，已激活卡的机器码由服务端签发，与它无关。
JSLB_MACHINE_SALT=

# ---- 网页版策略（服务端 + 界面都会读）----
# 与 vercel.json 的 env.JSLB_WEB_CONFIG 是同一份值。requireLicense=true 表示未激活一律拒绝。
JSLB_WEB_CONFIG={"requireLicense":true,"trialPreset":"low","trialMaxFileBytes":524288,"trialRunsPerDay":10}

# ---- 云存储（Upstash Redis，Vercel Marketplace 装完自动注入；本地可手填）----
# 认任意一对：KV_REST_API_URL/TOKEN 或 UPSTASH_REDIS_REST_URL/TOKEN。
# 不配会退化成单实例内存：授权与每日计数不跨实例持久化（/api/health 里 store=memory）。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- 发卡工具 ----
JSLABYRINTH_KEYGEN_STATE=./.keygen-state.json
JSLABYRINTH_LANG=zh
DSH_VM_DEBUG=1                          # VM 编译失败时打印原因

# ---- 测试（需要网络）----
# 线上验收目标站点：**必须显式给**，如 https://<你的站点>.vercel.app；不给则跳过该段。
JSLB_LIVE_ORIGIN=
JSLB_SKIP_LIVE=1                        # 跳过线上段，纯离线跑测试
JSLB_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe   # webfp 用的浏览器

# ---- 状态固定（便于测试）----
JSLB_DEVICE_ID=                         # 固定设备码（仅存储分键与试用计数）
JSLB_CORS_ORIGIN=*                      # 仅纯 API 部署时收紧跨域来源
