# 本地环境变量模板。复制成 .env 或 .dev.vars 后填入真值——两个文件都在 .gitignore 里。
#
# 这个文件里**只有占位符**，不要填真密钥。
# 完整部署流程见 DEPLOY.md 第 4 节。

# ---- 签发私钥（机密，只在签发方）----
# 取值：tools/issue/keyrotate.js --write 写入 .jslb-signing-key 的那一行 base64，
# 也就是 32 字节 Ed25519 种子。生产用环境变量或密钥管理服务注入。
#
# ⚠️ 泄露 JSLB_SIGNING_KEY = 泄露发卡权：别人能签出任意套餐、任意有效期的卡密，
#    而所有验签方都持有对应公钥，一定通过。绝不能进仓库、dist/ 或 wrangler.toml。
JSLB_SIGNING_KEY=

# ---- 公钥与机器盐（非机密，可公开）----
# 默认用 src/license-secret.js 里内置的那份，什么都不用配。
# 只有"用自己的密钥对签卡"时才需要覆盖成自己的公钥（tools/issue/keyrotate.js 会打印）。
# JSLB_PUBLIC_KEY=
# JSLB_MACHINE_SALT=

# ---- 命令行 / 发卡工具 ----
# JSLABYRINTH_LICENSE_KEY=JSLB-...        # 非交互激活用的卡密
# JSLABYRINTH_LICENSE_FILE=./license.lic  # 许可证路径
# JSLABYRINTH_LICENSE_DEBUG=1             # 打印陷阱原因
# JSLABYRINTH_KEYGEN_STATE=./.keygen-state.json
# JSLABYRINTH_SIGNING_KEY_FILE=./my-key   # 指定签发私钥文件路径（默认 .jslb-signing-key）
# JSLABYRINTH_LANG=zh
# DSH_DUMP_PASSES=1                       # 转储每个 pass 的中间产物为 _phase_<name>.js
# DSH_VM_DEBUG=1                          # VM 编译失败时打印原因

# ---- 线上验收（会打网络的测试）----
# JSLB_LIVE_ORIGIN=https://jslb.lllm.dpdns.org   # 验收目标域名，改部署时覆盖
# JSLB_SKIP_LIVE=1                                # 跳过线上段，纯离线跑测试
# JSLB_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe  # webfp 用的浏览器

# ---- 状态固定（便于测试）----
# JSLB_DEVICE_ID=                         # 固定设备码
# JSLB_CORS_ORIGIN=*                      # 仅纯 API 部署时收紧跨域来源
