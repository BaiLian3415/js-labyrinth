# 本地环境变量模板。复制成 .env 后填入真值（.env 在 .gitignore 里）。
#
# ⚠️ 这个文件**只有占位符**，不要填真密钥。完整部署流程见 DEPLOY.md。
#
# 说明：Vercel 上线时环境变量配在**项目设置**里（不是这个文件）；这个文件只管本地
# `npx vercel dev` 与发卡工具。变量名必须与这里一致，否则本地与线上行为会分叉。

# ---- 卡密密钥（机密）----
# v5 是**对称**体系：签发与验签共用同一把 32 字节密钥，浏览器本地验卡也要用它，
# 所以它随静态资源公开（见 src/license-secret.js 的头注释）。泄露 = 泄露发卡权：
# 人能签出任意套餐、任意有效期的卡密。
#
# 取值来源三选一，按此优先级：
#   1) 这个环境变量
#   2) 下面 JSLABYRINTH_CODE_KEY_FILE 指向的文件（默认 ./.jslb-code-key）
#   3) 都没有 → 回退到 src/license-secret.js 里内置的那把（开箱即用）
#
# 想要一把不进 git 的：node tools/issue/keyrotate.js --write（会同时改
# src/license-secret.js 并重算自身摘要表），再把打印出来的值填到这里。
# ⚠️ 绝不能提交进仓库或贴到 dist/。
#
# ⚠️ 这个变量名在 v5 只有**一个**含义。此前本文件写了两处（"签发私钥"与"覆盖用
#    公钥"），而 v5 已无公私钥之分——dotenv 后者覆盖前者，"私钥"会被静默换成公钥槽位。
JSLB_CODE_KEY=

# 签发密钥文件路径（相对项目根）。环境变量没给时 keygen.js 读这个文件。
JSLABYRINTH_CODE_KEY_FILE=./.jslb-code-key

# 机器码派生盐：只影响未激活时的兜底机器码，已激活卡的机器码由服务端签发，与它无关。
# 留空用 src/license-secret.js 里内置的值。
JSLB_MACHINE_SALT=

# ---- 网页版策略（服务端 + 界面都会读）----
# 与 vercel.json 的 env.JSLB_WEB_CONFIG 是同一份值。requireLicense=true 表示未激活一律拒绝。
JSLB_WEB_CONFIG={"requireLicense":true,"trialPreset":"low","trialMaxFileBytes":524288,"trialRunsPerDay":10}

# ---- 云存储（二选一，Vercel Marketplace 装完自动注入；本地可手填）----
# A) Upstash Redis（REST，最省事）：认任意一对
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# B) Vercel 官方 Redis（标准协议，走仓库自带的零依赖 RESP 客户端）
REDIS_URL=
# 都不配会退化成单实例内存：授权与每日计数不跨实例持久化（/api/health 里 store=memory），
# 且一卡一机的兑换登记随之失效（见 DEPLOY.md 第 3 节）。

# ---- 购买订单（定价页与发卡核验，2026-10-11）----
# 生成强随机值：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# 管理端令牌。**机密**：拿到它就能列出全部订单、确认收款并签发卡密。
# 不配 = /api/admin-order 恒 403（功能关闭，而不是默认敞开）。
# 本地核单时也用它：JSLB_ADMIN_TOKEN=<值> node tools/issue/orders.js list --status claimed
JSLB_ADMIN_TOKEN=
#
# 收款回调签名密钥。**机密**。配了才启用 /api/pay-notify（自动发卡）；
# 签名 = hex(HMAC-SHA256(密钥, 原始请求体))，放在 X-JSLB-Signature。
# 不配 = 该端点恒 401（个人收款码没有回调，默认走人工核验，这是预期状态）。
JSLB_PAY_WEBHOOK_SECRET=
#
# 下面三个是展示用，不配也能跑（有默认值）。
JSLB_PAY_QR=                    # 收款码图片路径，默认 /assets/pay-wechat.png
JSLB_PAY_PAYEE=                 # 收款方显示名，默认 JsLabyrinth
JSLB_PAY_CONTACT=               # 客服联系方式，默认不显示

# ---- 宿主包络覆盖（可选，一般不用配；数值见 src/host-limits.js）----
# 抬高上传上限前先确认平台套餐扛得住，写大了只会在线上表现为"某些文件必然 413"。
JSLB_MAX_UPLOAD_BYTES=            # 单次上传字节上限（默认 2 MiB）
JSLB_PER_RUN_CPU_SECONDS=         # 单任务 CPU 预算（默认 240）
JSLB_DAILY_CPU_SECONDS=           # 每日 CPU 预算（默认 500，Vercel Hobby 定）
JSLB_MAX_RESPONSE_BYTES=          # 回执字节上限（默认 64 MiB，超出走流式）

# ---- 发卡工具 ----
JSLABYRINTH_LANG=zh
DSH_VM_DEBUG=                     # 置 1：VM 编译失败时打印原因

# ---- 测试（需要网络）----
# 线上验收目标站点：**必须显式给**，如 https://<你的站点>.vercel.app；不给则跳过该段。
JSLB_LIVE_ORIGIN=
JSLB_SKIP_LIVE=1                        # 跳过线上段，纯离线跑测试
JSLB_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe   # webfp 用的浏览器

# ---- 状态固定（便于测试）----
JSLB_DEVICE_ID=                         # 固定设备码（仅存储分键与试用计数）
JSLB_CORS_ORIGIN=*                      # 仅纯 API 部署时收紧跨域来源
